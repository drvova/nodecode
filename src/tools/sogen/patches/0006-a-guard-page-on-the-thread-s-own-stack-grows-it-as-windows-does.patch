+
+        enum class stack_guard_outcome
+        {
+            not_on_stack,
+            grown,
+            exhausted,
+        };
+
+        // A guard page on the faulting thread's own stack is how Windows grows that stack and finds it
+        // exhausted (MiCheckForUserStackOverflow): the kernel clears the faulting page's guard, moves the
+        // guard region (a page plus the thread's guarantee, see SetThreadStackGuarantee) down below it and
+        // retries the access, raising nothing. When no room is left above the stack's last page, it commits
+        // the rest of the stack instead, so the handler has the guaranteed bytes to run in, and raises
+        // STATUS_STACK_OVERFLOW. Only a guard page anywhere else reaches the guest as
+        // STATUS_GUARD_PAGE_VIOLATION.
+        stack_guard_outcome handle_stack_guard_page(memory_manager& memory, emulator_thread& thread, const uint64_t address,
+                                                    const nt_memory_permission permissions)
+        {
+            if (!thread.teb64)
+            {
+                return stack_guard_outcome::not_on_stack;
+            }
+
+            const auto teb = thread.teb64->read();
+            const auto stack_bottom = teb.DeallocationStack;
+            const auto stack_top = teb.NtTib.StackBase;
+            if (address < stack_bottom || address >= stack_top)
+            {
+                return stack_guard_outcome::not_on_stack;
+            }
+
+            constexpr uint64_t page_size = 0x1000;
+            const auto usable = permissions & ~memory_permission_ext::guard;
+            const auto page = page_align_down(address);
+            const auto guard_size = page_size + page_align_up(teb.GuaranteedStackBytes);
+
+            if (page < stack_bottom + guard_size + page_size * 2)
+            {
+                const auto limit = stack_bottom + page_size;
+                memory.protect_memory(limit, static_cast<size_t>(page + page_size - limit), usable);
+                thread.teb64->access([&](TEB64& t) { t.NtTib.StackLimit = limit; });
+                return stack_guard_outcome::exhausted;
+            }
+
+            memory.protect_memory(page, page_size, usable);
+            memory.protect_memory(page - guard_size, static_cast<size_t>(guard_size), permissions);
+            thread.teb64->access([&](TEB64& t) { t.NtTib.StackLimit = page; });
+            return stack_guard_outcome::grown;
+        }
     }
 
