+#pragma once
+
+#include "../port.hpp"
+
+namespace sogen
+{
+    // The Network Store Interface service's RPC interface, {7ea70bcf-48af-4f6a-8968-6a440754d5fa} v1.0, and
+    // the ncalrpc endpoint the endpoint mapper resolves it to: winnsi.dll binds with no endpoint of its own.
+    constexpr std::array<uint8_t, 16> network_store_interface{0xcf, 0x0b, 0xa7, 0x7e, 0xaf, 0x48, 0x6a, 0x4f,
+                                                              0x89, 0x68, 0x6a, 0x44, 0x07, 0x54, 0xd5, 0xfa};
+    constexpr std::string_view network_store_endpoint = "SogenNsi";
+    constexpr std::u16string_view network_store_port_name = u"\\RPC Control\\SogenNsi";
+
+    std::unique_ptr<port> create_network_store_port();
+
+} // namespace sogen
