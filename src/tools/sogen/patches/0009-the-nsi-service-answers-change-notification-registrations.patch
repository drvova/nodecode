diff --git a/src/windows-emulator/ports/network_store.cpp b/src/windows-emulator/ports/network_store.cpp
new file mode 100644
index 0000000..7e87029
--- /dev/null
+++ b/src/windows-emulator/ports/network_store.cpp
@@ -0,0 +1,54 @@
+#include "../std_include.hpp"
+#include "network_store.hpp"
+
+#include "binary_writer.hpp"
+#include "../windows_emulator.hpp"
+
+namespace sogen
+{
+    namespace
+    {
+        // The opnums winnsi.dll calls for iphlpapi's change notifications (NotifyIpInterfaceChange,
+        // NotifyUnicastIpAddressChange and their kin): it registers with opnum 5 and waits for that to
+        // complete, then leaves opnum 7 outstanding -- an asynchronous call the service completes when the
+        // watched object changes -- and deregisters with opnum 6. Each answers a status.
+        constexpr uint32_t register_change_notification = 5;
+        constexpr uint32_t deregister_change_notification = 6;
+        constexpr uint32_t wait_for_change = 7;
+
+        // Sogen's network does not change under the guest, so a registration succeeds and its notification
+        // never comes. The interface's other calls read and write NSI parameters, whose replies carry data
+        // this does not have; those are refused.
+        struct network_store_port : rpc_port
+        {
+            NTSTATUS handle_rpc(windows_emulator& /*win_emu*/, const uint32_t procedure_id, const lpc_request_context& /*c*/,
+                                utils::aligned_binary_writer& writer, std::vector<alpc_reply_handle>& /*reply_handles*/) override
+            {
+                if (this->bound_interface() != network_store_interface)
+                {
+                    return STATUS_NOT_SUPPORTED;
+                }
+
+                if (procedure_id == wait_for_change)
+                {
+                    return STATUS_PENDING;
+                }
+
+                if (procedure_id != register_change_notification && procedure_id != deregister_change_notification)
+                {
+                    return STATUS_NOT_SUPPORTED;
+                }
+
+                writer.align_to(sizeof(uint32_t));
+                writer.write<uint32_t>(0);
+                return STATUS_SUCCESS;
+            }
+        };
+    }
+
+    std::unique_ptr<port> create_network_store_port()
+    {
+        return std::make_unique<network_store_port>();
+    }
+
+} // namespace sogen
