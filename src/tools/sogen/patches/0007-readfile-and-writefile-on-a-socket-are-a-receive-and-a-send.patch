+            // afd.sys serves a socket's IRP_MJ_READ and IRP_MJ_WRITE as a receive and a send without flags, so
+            // ReadFile and WriteFile work on a socket handle; runtimes that treat sockets as files do all their
+            // socket I/O that way (SBCL, for one).
+            NTSTATUS file_read(windows_emulator& win_emu, const io_device_context& c)
+            {
+                if (!this->s_)
+                {
+                    throw std::runtime_error("Invalid AFD endpoint socket!");
+                }
+
+                if (c.output_buffer_length == 0)
+                {
+                    if (c.io_status_block)
+                    {
+                        c.io_status_block.write({});
+                    }
+                    return STATUS_SUCCESS;
+                }
+
+                EMU_WSABUF<Traits> buffer{};
+                buffer.len = c.output_buffer_length;
+                buffer.buf = static_cast<decltype(buffer.buf)>(c.output_buffer);
+                return this->receive_into(win_emu, c, std::span{&buffer, 1},
+                                          std::min<size_t>(buffer.len, max_stream_transfer_bytes));
+            }
+
+            NTSTATUS file_write(windows_emulator& win_emu, const io_device_context& c)
+            {
+                if (!this->s_)
+                {
+                    throw std::runtime_error("Invalid AFD endpoint socket!");
+                }
+
+                std::vector<std::byte> host_buffer(std::min<size_t>(c.input_buffer_length, max_stream_transfer_bytes));
+                if (!host_buffer.empty())
+                {
+                    win_emu.emu().read_memory(c.input_buffer, host_buffer.data(), host_buffer.size());
+                }
+
+                return this->send_from(win_emu, c, host_buffer);
+            }
