+    namespace
+    {
+        // The exception Windows reports for a set of pending, unmasked floating-point exception flags (the low
+        // six bits of the x87 status word or of MXCSR): invalid operation first -- a stack check when the x87
+        // stack faulted -- then divide by zero, denormal operand, overflow, underflow, inexact result.
+        DWORD floating_point_status(const uint32_t pending, const bool stack_fault)
+        {
+            if (pending & 0x01)
+            {
+                return static_cast<DWORD>(stack_fault ? STATUS_FLOAT_STACK_CHECK : STATUS_FLOAT_INVALID_OPERATION);
+            }
+            if (pending & 0x04)
+            {
+                return static_cast<DWORD>(STATUS_FLOAT_DIVIDE_BY_ZERO);
+            }
+            if (pending & 0x02)
+            {
+                return static_cast<DWORD>(STATUS_FLOAT_DENORMAL_OPERAND);
+            }
+            if (pending & 0x08)
+            {
+                return static_cast<DWORD>(STATUS_FLOAT_OVERFLOW);
+            }
+            if (pending & 0x10)
+            {
+                return static_cast<DWORD>(STATUS_FLOAT_UNDERFLOW);
+            }
+            if (pending & 0x20)
+            {
+                return static_cast<DWORD>(STATUS_FLOAT_INEXACT_RESULT);
+            }
+            return static_cast<DWORD>(STATUS_FLOAT_INVALID_OPERATION);
+        }
+    }
+
+    // #MF: an x87 instruction found an unmasked exception pending from an earlier one.
+    void dispatch_x87_floating_point_error(windows_emulator& win_emu, vcpu_context& vcpu)
+    {
+        auto& cpu = vcpu.x64_cpu();
+        const auto status_word = cpu.reg<uint16_t>(x86_register::fpsw);
+        const auto control_word = cpu.reg<uint16_t>(x86_register::fpcw);
+        const auto pending = static_cast<uint32_t>(status_word & ~control_word & 0x3F);
+        dispatch_exception(win_emu, vcpu, floating_point_status(pending, (status_word & 0x40) != 0), {});
+
+        // The exception stays pending until the status word is cleared, and the next x87 instruction -- the
+        // handler's own -- would raise #MF again: it goes with the CONTEXT just laid, not with the CPU. Left
+        // pending, the guest re-raised it forever, as Sogen logged "Interrupt 16" and resumed the instruction.
+        cpu.reg<uint16_t>(x86_register::fpsw, static_cast<uint16_t>(status_word & ~0x80FF));
+    }
+
+    // #XM: an SSE instruction raised an unmasked exception. SSE exceptions are precise, so nothing stays
+    // pending in the CPU.
+    void dispatch_simd_floating_point_exception(windows_emulator& win_emu, vcpu_context& vcpu)
+    {
+        auto& cpu = vcpu.x64_cpu();
+        const auto mxcsr = cpu.reg<uint32_t>(x86_register::mxcsr);
+        const auto pending = mxcsr & ~(mxcsr >> 7) & 0x3F;
+        dispatch_exception(win_emu, vcpu, floating_point_status(pending, false), {});
+    }
+
     void dispatch_single_step(windows_emulator& win_emu, vcpu_context& vcpu)
     {
         dispatch_exception(win_emu, vcpu, STATUS_SINGLE_STEP, {});
