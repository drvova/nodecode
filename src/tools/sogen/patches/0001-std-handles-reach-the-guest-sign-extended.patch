Sogen: the standard handles reach the guest sign-extended

Sogen's pseudo handles set bit 31 (handle_value.is_pseudo), and the process
parameters carried stdin, stdout and the console as that value zero-extended:
stdout is 0x0000000080800008. No real handle has such a value. Only a handle's
low 32 bits are significant, and Windows keeps the 64-bit value their sign
extension, so a guest may hold a handle in a 32-bit int and widen it back.
SBCL's Windows runtime does exactly that: its first write to the console
signalled "The value 2155872264 is not of type (SIGNED-BYTE 32) when binding
SB-ALIEN::VALUE", and nothing it printed through Lisp ever reached the host.

The process parameters now carry guest_handle_bits(handle), the sign-extended
value. Sogen already compares handles on their low 32 bits (operator==); the
one check that compared the full value, the console driver's target handle,
now does the same.

diff --git a/src/windows-emulator/devices/console.cpp b/src/windows-emulator/devices/console.cpp
index 0ef468e..56f8cba 100644
--- a/src/windows-emulator/devices/console.cpp
+++ b/src/windows-emulator/devices/console.cpp
@@ -331,8 +331,10 @@ namespace sogen
 
                 console_ioctl_header header{};
                 win_emu.emu().read_memory(context.input_buffer, &header, sizeof(header));
-                if (header.target_handle != STDIN_HANDLE.h && header.target_handle != STDOUT_HANDLE.h &&
-                    header.target_handle != CONSOLE_HANDLE.h && header.target_handle != 0)
+                // Compared on the low 32 bits, as handle's own operator== does: the guest holds these
+                // sign-extended (guest_handle_bits).
+                const auto target = make_handle(header.target_handle);
+                if (target != STDIN_HANDLE && target != STDOUT_HANDLE && target != CONSOLE_HANDLE && header.target_handle != 0)
                 {
                     return STATUS_INVALID_PARAMETER;
                 }
diff --git a/src/windows-emulator/handles.hpp b/src/windows-emulator/handles.hpp
index 18d6092..1a70d32 100644
--- a/src/windows-emulator/handles.hpp
+++ b/src/windows-emulator/handles.hpp
@@ -134,6 +134,15 @@ namespace sogen
         return make_handle(id, type, true);
     }
 
+    // The value a handle takes in guest memory. Only a handle's low 32 bits are significant, and Windows keeps
+    // its 64-bit value their sign extension, so a guest may hold a handle in a 32-bit int and widen it back
+    // (SBCL's runtime passes the standard handles through C ints). A pseudo handle sets bit 31: zero-extended,
+    // it is a value no real handle has.
+    constexpr uint64_t guest_handle_bits(const handle h)
+    {
+        return static_cast<uint64_t>(static_cast<int64_t>(static_cast<int32_t>(static_cast<uint32_t>(h.bits))));
+    }
+
     namespace handle_detail
     {
         template <typename, typename = void>
diff --git a/src/windows-emulator/process_context.cpp b/src/windows-emulator/process_context.cpp
index e01b627..2eea095 100644
--- a/src/windows-emulator/process_context.cpp
+++ b/src/windows-emulator/process_context.cpp
@@ -375,9 +375,9 @@ namespace sogen
         this->process_params64.access([&](RTL_USER_PROCESS_PARAMETERS64& proc_params) {
             proc_params.Flags = 0x6001; //| 0x80000000; // Prevent CsrClientConnectToServer
 
-            proc_params.ConsoleHandle = CONSOLE_HANDLE.h;
-            proc_params.StandardOutput = STDOUT_HANDLE.h;
-            proc_params.StandardInput = STDIN_HANDLE.h;
+            proc_params.ConsoleHandle = guest_handle_bits(CONSOLE_HANDLE);
+            proc_params.StandardOutput = guest_handle_bits(STDOUT_HANDLE);
+            proc_params.StandardInput = guest_handle_bits(STDIN_HANDLE);
             proc_params.StandardError = proc_params.StandardOutput;
 
             proc_params.Environment = allocator.copy_string(u"=::=::\\");
